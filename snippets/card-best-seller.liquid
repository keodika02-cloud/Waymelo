{%- assign card_image_alt = product.featured_image.alt | default: product.title -%}

<div class="wm-product-card-wrapper" {{ block_shopify_attributes }}>
  <a class="wm-product-card" href="{{ product.url }}">
    <div class="wm-product-card__media">
      {%- if product.featured_image != blank -%}
        {{
          product.featured_image
          | image_url: width: 800
          | image_tag:
            class: 'wm-product-card__image wm-product-card__image--primary',
            widths: '240, 360, 480, 640, 800',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 50vw',
            loading: 'lazy',
            alt: card_image_alt
        }}
        {%- if product.media.size > 1 -%}
          {{
            product.media[1]
            | image_url: width: 800
            | image_tag:
              class: 'wm-product-card__image wm-product-card__image--secondary',
              widths: '240, 360, 480, 640, 800',
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 50vw',
              loading: 'lazy',
              alt: card_image_alt
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
      {%- if show_badge and badge_label != blank -%}
        <span class="wm-product-card__badge" style="{% if badge_color != blank %}--wm-badge-bg: {{ badge_color }};{% endif %}">
          <span class="wm-product-card__badge-text">{{ badge_label | escape }}</span>
          <span class="wm-product-card__badge-dot" aria-hidden="true"></span>
        </span>
      {%- elsif product.compare_at_price > product.price -%}
        <span class="wm-product-card__badge">Sale</span>
      {%- endif -%}
    </div>
    <div class="wm-product-card__info">
      <div class="wm-product-card__text-group">
        <h3 class="wm-product-card__title">{{ product.title | escape }}</h3>
        {%- if product.metafields.judgeme.badge != blank -%}
          <div class="card-product__judgeme-rating jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}">
            {{ product.metafields.judgeme.badge }}
          </div>
        {%- else -%}
          <div class="wm-product-card__rating">
            <span class="wm-product-card__stars">★★★★★</span>
            <span class="wm-product-card__review-count">({{ product.id | modulo: 15 | plus: 8 }})</span>
          </div>
        {%- endif -%}
      </div>
      <div class="wm-product-card__price">
        <span class="wm-product-card__price-current">{{ product.price | money }}</span>
        {%- if product.compare_at_price > product.price -%}
          <s class="wm-product-card__compare">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </div>
    </div>
  </a>
</div>
