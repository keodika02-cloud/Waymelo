{{ 'section-product-addons.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
{{ 'waymelo-quick-choose.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'waymelo-quick-choose.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-addons.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign addon_products = section.settings.products
  assign has_addons = false
  if addon_products != blank and addon_products.count > 0
    assign has_addons = true
  endif
-%}

{%- if has_addons or request.design_mode -%}
  <product-addons
    id="ProductAddons-{{ section.id }}"
    class="product-addons waymelo-collection-products"
    style="
      --addons-background: {{ section.settings.background_color }};
      --addons-panel: {{ section.settings.panel_color }};
      --addons-card: {{ section.settings.card_color }};
      --addons-text: {{ section.settings.text_color }};
      --addons-muted: {{ section.settings.muted_color }};
      --addons-accent: {{ section.settings.accent_color }};
      --addons-card-width: {{ section.settings.card_width }}px;
      --addons-padding-top: {{ section.settings.padding_top }}px;
      --addons-padding-bottom: {{ section.settings.padding_bottom }}px;
    "
  >
    <div class="page-width">
      <div class="product-addons__panel">
        <div class="product-addons__header">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-addons__heading">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subtitle != blank -%}
            <p class="product-addons__subtitle">{{ section.settings.subtitle | escape }}</p>
          {%- endif -%}
        </div>

        {%- if has_addons -%}
          <div class="product-addons__slider">
            <button
              class="product-addons__arrow product-addons__arrow--previous"
              type="button"
              aria-label="Previous add-on products"
              data-addons-previous
            >
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m12.5 4.5-5 5.5 5 5.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>
            </button>

            <div class="product-addons__track" data-addons-track>
              {%- assign skip_card_product_styles = false -%}
              {%- for addon_product in addon_products -%}
                <div class="product-addons__card-item" data-addon-card>
                  {% render 'card-product',
                    card_product: addon_product,
                    media_aspect_ratio: 'square',
                    image_shape: 'default',
                    show_secondary_image: true,
                    show_vendor: false,
                    show_rating: true,
                    lazy_load: true,
                    skip_styles: skip_card_product_styles,
                    section_id: section.id,
                    quick_add: 'standard'
                  %}
                </div>
                {%- assign skip_card_product_styles = true -%}
              {%- endfor -%}
            </div>

            <button
              class="product-addons__arrow product-addons__arrow--next"
              type="button"
              aria-label="Next add-on products"
              data-addons-next
            >
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7.5 4.5 5 5.5-5 5.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8"/></svg>
            </button>
          </div>
        {%- else -%}
          <div class="product-addons__empty">
            Select add-on products in this section's settings.
          </div>
        {%- endif -%}
      </div>
    </div>
  </product-addons>
{%- endif -%}

{% schema %}
{
  "name": "Product add-ons",
  "tag": "section",
  "class": "section-product-addons",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Add These to Your Order"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Choose any. Each one is 10% off."
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Add-on products",
      "limit": 12
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add & Save"
    },
    {
      "type": "range",
      "id": "discount_percentage",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Discount percentage",
      "info": "Display only. Create a matching automatic discount in Shopify so cart and checkout use the same price.",
      "default": 10
    },
    {
      "type": "range",
      "id": "card_width",
      "min": 180,
      "max": 320,
      "step": 10,
      "unit": "px",
      "label": "Card width",
      "default": 230
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Panel background",
      "default": "#f7f3f8"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#24162a"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#6f6572"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Button and accent",
      "default": "#91329a"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Product add-ons"
    }
  ]
}
{% endschema %}
