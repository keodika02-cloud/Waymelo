{%- liquid
  assign featured_collection = section.settings.collection
  if featured_collection == blank
    assign featured_collection = collections.all
  endif
  assign has_products = false
  if section.settings.source == 'manual'
    for block in section.blocks
      if block.settings.product != blank
        assign has_products = true
      endif
    endfor
  elsif featured_collection.products.size > 0
    assign has_products = true
  endif
-%}

<section class="wm-home wm-home__section wm-best-seller" aria-labelledby="WaymeloBestSellerTitle-{{ section.id }}">
  <div class="wm-home__shell">
    <div class="wm-home__section-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="wm-home__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="wm-home__heading" id="WaymeloBestSellerTitle-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    </div>

    <div
      class="wm-product-grid wm-best-seller__grid"
      aria-label="Best seller products"
      style="--wm-best-seller-columns: {{ section.settings.columns_desktop }}"
    >
      {%- if has_products -%}
        {%- if section.settings.source == 'manual' -%}
          {%- assign rendered_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if rendered_count >= section.settings.products_to_show -%}
              {%- break -%}
            {%- endif -%}
            {%- if block.settings.product != blank -%}
              {%- render 'card-best-seller',
                product: block.settings.product,
                badge_label: section.settings.badge_text,
                show_badge: section.settings.show_badge
              -%}
              {%- assign rendered_count = rendered_count | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
            {%- render 'card-best-seller',
              product: product,
              badge_label: section.settings.badge_text,
              show_badge: section.settings.show_badge
            -%}
          {%- endfor -%}
        {%- endif -%}
      {%- else -%}
        {%- for index in (1..section.settings.products_to_show) -%}
          <div class="wm-product-card">
            <div class="wm-product-card__media">{{ 'product-' | append: index | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <div class="wm-product-card__info">
              <h3 class="wm-product-card__title">Product title</h3>
              <span class="wm-product-card__price">{{ 5999 | money }}</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
      <div class="wm-best-seller__view-all-row">
        <a class="wm-home__button wm-best-seller__view-all" href="{{ section.settings.view_all_link }}">
          {{ section.settings.view_all_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Waymelo best seller",
  "tag": "section",
  "class": "section-waymelo-best-seller",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best Seller" },
    {
      "type": "select",
      "id": "source",
      "label": "Product source",
      "options": [
        { "value": "collection", "label": "Collection" },
        { "value": "manual", "label": "Manual products" }
      ],
      "default": "collection"
    },
    { "type": "collection", "id": "collection", "label": "Collection" },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Columns on desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 4
    },
    { "type": "checkbox", "id": "show_badge", "label": "Show sale badge", "default": true },
    { "type": "text", "id": "badge_text", "label": "Badge label", "default": "Sale ends at midnight" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view all button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View all" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 12,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [{ "name": "Waymelo best seller" }]
}
{% endschema %}
